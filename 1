required_packages <- c(
  "psych","GPArotation","FactoMineR","factoextra","MASS",
  "lavaan","semPlot","cluster","corrplot"
)

for(pkg in required_packages){
  if(!require(pkg, character.only = TRUE)){
    install.packages(pkg, dependencies = TRUE)
    library(pkg, character.only = TRUE)
  }
}

# =========================
# SAMPLE DATASET
# =========================
data(iris)
df <- iris[,1:4]
group <- iris$Species

# ============================================================
# 1. PRINCIPAL COMPONENT ANALYSIS (PCA)
# ============================================================

# Standardize variables
df_scaled <- scale(df)

# Correlation Matrix
corrplot(cor(df_scaled), method="color", tl.cex=0.8)

# Bartlett’s Test
bart <- cortest.bartlett(cor(df_scaled), n=nrow(df_scaled))
print(bart)

# KMO Test
kmo <- KMO(df_scaled)
print(kmo)

# PCA Model
pca_result <- prcomp(df_scaled)

# Eigenvalues
eig <- pca_result$sdev^2
print(eig)

# Scree Plot
plot(eig, type="b", pch=19,
     main="PCA Scree Plot",
     xlab="Principal Components",
     ylab="Eigenvalue")
abline(h=1, col="red", lty=2)

# Component Loadings
print(pca_result$rotation)

# Biplot
biplot(pca_result)

# ---------------- INTERPRETATION: PCA ----------------
# Bartlett’s Test:
# p < .05 → Variables are significantly correlated, PCA is appropriate.
# p ≥ .05 → Variables are not sufficiently correlated, PCA may not be useful.
#
# KMO:
# > .90 Excellent | > .80 Great | > .70 Good | > .60 Acceptable | < .50 Poor
#
# Eigenvalues:
# Retain components with Eigenvalue > 1 (Kaiser Criterion).
#
# Scree Plot:
# Retain components before elbow point.
#
# Loadings:
# > |0.7| Strong | > |0.5| Moderate | < |0.4| Weak
#
# Overall:
# PCA reduces dimensionality while preserving maximum variance.


# ============================================================
# 2. FACTOR ANALYSIS (FA)
# ============================================================

# Parallel Analysis
fa.parallel(df_scaled, fa="fa")

# FA Model
fa_result <- fa(df_scaled, nfactors=2, rotate="varimax", fm="ml")
print(fa_result)

# Loadings
print(fa_result$loadings)

# Diagram
fa.diagram(fa_result)

# ---------------- INTERPRETATION: FA ----------------
# Parallel Analysis:
# Retain factors where observed eigenvalues > simulated eigenvalues.
#
# Factor Loadings:
# > .70 Strong | .40–.69 Moderate | < .40 Weak
#
# Cross-loading:
# Strong loading on multiple factors = poor interpretability.
#
# Communality:
# High = factor explains variable well.
# Low = variable poorly represented.
#
# Uniqueness:
# High uniqueness = variable largely independent from common factor.
#
# Overall:
# FA identifies latent constructs underlying observed correlations.


# ============================================================
# 3. MULTIDIMENSIONAL SCALING (MDS)
# ============================================================
# MDS is used to visualize similarity or dissimilarity among objects
# by representing them spatially in fewer dimensions (usually 2D).

# =========================
# INSTALL & LOAD PACKAGE
# =========================
if(!require(smacof)){
  install.packages("smacof")
  library(smacof)
}

if(!require(ggplot2)){
  install.packages("ggplot2")
  library(ggplot2)
}

if(!require(ggrepel)){
  install.packages("ggrepel")
  library(ggrepel)
}

# =========================
# EXAMPLE DATA: Automobile Brands
# =========================
brands <- c("Toyota","Honda","Ford","BMW","Mercedes","Maruti","Hyundai","Audi")

# Dissimilarity Matrix
# Lower values = more similar
# Higher values = more dissimilar
dissim <- matrix(c(
  0, 2, 4, 7, 8, 5, 3, 7,
  2, 0, 4, 7, 8, 5, 3, 7,
  4, 4, 0, 6, 7, 4, 4, 6,
  7, 7, 6, 0, 2, 8, 7, 2,
  8, 8, 7, 2, 0, 9, 8, 3,
  5, 5, 4, 8, 9, 0, 2, 8,
  3, 3, 4, 7, 8, 2, 0, 7,
  7, 7, 6, 2, 3, 8, 7, 0
), nrow=8, byrow=TRUE)

rownames(dissim) <- brands
colnames(dissim) <- brands

print(dissim)

# ============================================================
# A. METRIC MDS (Classical MDS)
# ============================================================

# cmdscale() preserves actual distance magnitudes
mds_metric <- cmdscale(dissim, k=2, eig=TRUE)

# Eigenvalues
print(mds_metric$eig)

# Goodness of Fit
gof <- sum(mds_metric$eig[1:2]) / sum(abs(mds_metric$eig))
print(gof)

# Coordinates
metric_coords <- as.data.frame(mds_metric$points)
colnames(metric_coords) <- c("Dim1","Dim2")
metric_coords$Brand <- brands

# Perceptual Map
ggplot(metric_coords, aes(x=Dim1, y=Dim2, label=Brand)) +
  geom_point(size=4, color="blue") +
  geom_text_repel(size=4) +
  geom_hline(yintercept=0, linetype="dashed") +
  geom_vline(xintercept=0, linetype="dashed") +
  labs(
    title="Metric MDS Perceptual Map",
    subtitle=paste("Goodness of Fit =", round(gof,3)),
    x="Dimension 1",
    y="Dimension 2"
  ) +
  theme_minimal()

# ---------------- INTERPRETATION: METRIC MDS ----------------
# Goodness of Fit (GoF):
# > .90 = Excellent representation
# .80–.90 = Good
# .60–.79 = Moderate
# < .60 = Weak representation
#
# Brands close together:
# Perceived as similar
#
# Brands far apart:
# Perceived as dissimilar
#
# Dimensions:
# Interpreted conceptually (e.g., Economy vs Luxury)


# ============================================================
# B. NON-METRIC MDS (Ordinal MDS)
# ============================================================

# Convert dissimilarity for ordinal scaling
diss_obj <- as.dist(dissim)

# Run Non-Metric MDS
mds_nonmetric <- mds(diss_obj, ndim=2, type="ordinal")

# Stress Value
print(mds_nonmetric$stress)

# Configuration Plot
plot(mds_nonmetric,
     main="Non-Metric MDS Configuration")

# Shepard Diagram
plot(mds_nonmetric,
     plot.type="Shepard",
     main="Shepard Diagram - Non-Metric MDS")

# ============================================================
# C. STRESS SCREE PLOT
# ============================================================

stress_vals <- numeric(5)

for(i in 1:5){
  fit <- mds(diss_obj, ndim=i, type="ordinal")
  stress_vals[i] <- fit$stress
}

plot(1:5, stress_vals,
     type="b",
     pch=19,
     col="red",
     xlab="Number of Dimensions",
     ylab="Stress",
     main="Stress Scree Plot")
abline(h=0.05, lty=2)
abline(h=0.10, lty=2)
abline(h=0.20, lty=2)

# ---------------- INTERPRETATION: NON-METRIC MDS ----------------
# Stress Value:
# < .05 = Excellent fit
# .05–.10 = Good fit
# .10–.20 = Fair / Acceptable
# > .20 = Poor fit
#
# Lower stress = Better low-dimensional representation
#
# Shepard Diagram:
# Points close to monotonic line = Good fit
# Large scatter = Poor fit
#
# Scree Plot:
# Choose dimensions where stress reduction levels off (“elbow”)


# ============================================================
# FINAL MDS EXAM LOGIC
# ============================================================
# Metric MDS:
# Focuses on preserving actual distances
#
# Non-Metric MDS:
# Focuses on preserving rank-order relationships
#
# If GoF high + Stress low:
# MDS solution is strong and interpretable
#
# If GoF low + Stress high:
# Representation may be misleading
#
# Practical Use:
# Brand maps, consumer perception, similarity studies,
# product positioning, competitive analysis
