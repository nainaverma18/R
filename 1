# ============================================================
# 4. CORRESPONDENCE ANALYSIS (CA)
# ============================================================

# Contingency Table
data(HairEyeColor)
ca_table <- margin.table(HairEyeColor, c(1,2))

# Chi-square Test
chi <- chisq.test(ca_table)
print(chi)

# CA Model
ca_result <- CA(ca_table, graph=FALSE)

# Eigenvalues / Inertia
print(ca_result$eig)

# Biplot
fviz_ca_biplot(ca_result, repel=TRUE)

# ---------------- INTERPRETATION: CA ----------------
# Chi-square:
# p < .05 → Significant association between categories.
# p ≥ .05 → No strong categorical association.
#
# Inertia:
# Higher inertia = more variance explained by dimension.
#
# Biplot:
# Categories close together are associated.
# Categories far apart differ strongly.
# Distance from origin = contribution strength.
#
# Overall:
# CA visually maps relationships among categorical variables.


# ============================================================
# 5. STRUCTURAL EQUATION MODELING (SEM)
# ============================================================

# Load SEM dataset
dat <- read.csv("https://stats.idre.ucla.edu/wp-content/uploads/2021/02/worland5.csv")

# SEM Model
sem_model <- '
adjust =~ motiv + harm + stabi
risk =~ verbal + ses + ppsych
achieve =~ read + arith + spell

adjust ~ risk
achieve ~ adjust + risk
'

fit <- sem(sem_model, data=dat)

# Summary
summary(fit, standardized=TRUE, fit.measures=TRUE)

# Path Diagram
semPaths(fit, "std", layout="tree")

# Fit Measures
fitMeasures(fit)

# ---------------- INTERPRETATION: SEM ----------------
# Chi-square:
# p > .05 = Good exact fit
# p < .05 = Model misfit (common with large samples)
#
# CFI / TLI:
# > .95 Excellent | > .90 Acceptable | < .90 Weak
#
# RMSEA:
# < .05 Excellent | .05–.08 Acceptable | > .08 Poor
#
# SRMR:
# < .08 Good fit
#
# Path Coefficients:
# Significant = meaningful predictor effect
# Non-significant = weak/no evidence
#
# Factor Loadings:
# High = strong latent construct indicator
#
# Overall:
# SEM tests measurement + structural relationships simultaneously.


