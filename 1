# 1. IMPORT LIBRARIES

import pandas as pd
import numpy as np
import seaborn as sns
import matplotlib.pyplot as plt

from sklearn.model_selection import train_test_split
from sklearn.preprocessing import OneHotEncoder, StandardScaler
from sklearn.linear_model import LogisticRegression
from sklearn.multiclass import OneVsOneClassifier
from sklearn.metrics import accuracy_score

import warnings
warnings.filterwarnings('ignore')


# 2. IMPORT DATASET

data = pd.read_csv(
    "/Users/titlibhattacharya/Downloads/Obesity_level_prediction_dataset.csv"
)

print(data.head())


# 3. BASIC DATA CHECK

data.info()

print("\nStatistical description:")
print(data.describe())

print("\nColumn names:")
print(data.columns)


# 4. TARGET DISTRIBUTION

sns.countplot(
    y='NObeyesdad',
    data=data
)

plt.title("Distribution of Obesity Level")
plt.show()


# 5. CHECK MISSING VALUES

print("\nMissing values:")
print(data.isnull().sum())


# ============================================================
# 6. STANDARDIZE CONTINUOUS NUMERICAL FEATURES
# ============================================================

continuous_columns = data.select_dtypes(
    include=["float64"]
).columns.tolist()

scaler = StandardScaler()

scaled_features = scaler.fit_transform(
    data[continuous_columns]
)

scaled_df = pd.DataFrame(
    scaled_features,
    columns=scaler.get_feature_names_out(
        continuous_columns
    )
)

scaled_data = pd.concat(
    [
        data.drop(columns=continuous_columns),
        scaled_df
    ],
    axis=1
)


# ============================================================
# 7. ONE-HOT ENCODE CATEGORICAL FEATURES
# ============================================================

categorical_columns = scaled_data.select_dtypes(
    include=["object"]
).columns.tolist()

categorical_columns.remove(
    "NObeyesdad"
)

encoder = OneHotEncoder(
    sparse_output=False,
    drop="first"
)

encoded_features = encoder.fit_transform(
    scaled_data[categorical_columns]
)

encoded_df = pd.DataFrame(
    encoded_features,
    columns=encoder.get_feature_names_out(
        categorical_columns
    )
)

prepped_data = pd.concat(
    [
        scaled_data.drop(
            columns=categorical_columns
        ),
        encoded_df
    ],
    axis=1
)


# ============================================================
# 8. ENCODE TARGET VARIABLE
# ============================================================

prepped_data["NObeyesdad"] = (
    prepped_data["NObeyesdad"]
    .astype("category")
    .cat.codes
)


# ============================================================
# 9. DEFINE X AND y
# ============================================================

x = prepped_data.drop(
    'NObeyesdad',
    axis=1
)

y = prepped_data["NObeyesdad"]


# ============================================================
# 10. FUNCTION TO RUN OVA AND OVO
# ============================================================

def run_multiclass_models(
    test_size,
    random_state
):

    x_train, x_test, y_train, y_test = train_test_split(
        x,
        y,
        test_size=test_size,
        random_state=random_state,
        stratify=y
    )


    # --------------------------------------------------------
    # ONE-VS-ALL
    # --------------------------------------------------------

    model_ova = LogisticRegression(
        multi_class="ovr",
        max_iter=1000
    )

    model_ova.fit(
        x_train,
        y_train
    )

    y_pred_ova = model_ova.predict(
        x_test
    )

    accuracy_ova = accuracy_score(
        y_test,
        y_pred_ova
    )


    # --------------------------------------------------------
    # ONE-VS-ONE
    # --------------------------------------------------------

    model_ovo = OneVsOneClassifier(
        LogisticRegression(
            max_iter=1000
        )
    )

    model_ovo.fit(
        x_train,
        y_train
    )

    y_pred_ovo = model_ovo.predict(
        x_test
    )

    accuracy_ovo = accuracy_score(
        y_test,
        y_pred_ovo
    )


    print(
        f"\nTest size = {test_size}"
    )

    print(
        "One-vs-All (OvA) Accuracy:",
        np.round(100 * accuracy_ova, 2),
        "%"
    )

    print(
        "One-vs-One (OvO) Accuracy:",
        np.round(100 * accuracy_ovo, 2),
        "%"
    )


# ============================================================
# 11. TEST SIZE = 0.2
# ============================================================

run_multiclass_models(
    test_size=0.2,
    random_state=42
)


# ============================================================
# 12. TEST SIZE = 0.1
# ============================================================

run_multiclass_models(
    test_size=0.1,
    random_state=42
)


# ============================================================
# 13. TEST SIZE = 0.3
# ============================================================

run_multiclass_models(
    test_size=0.3,
    random_state=45
)



