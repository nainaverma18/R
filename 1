# 6. CLUSTER ANALYSIS
# ============================================================

# Distance Matrix
dist_mat <- dist(df_scaled)

# Hierarchical Clustering
hc <- hclust(dist_mat, method="ward.D2")
plot(hc)

# K-Means
set.seed(123)
kmeans_result <- kmeans(df_scaled, centers=3, nstart=25)
print(kmeans_result)

# Elbow Method
fviz_nbclust(df_scaled, kmeans, method="wss")

# Silhouette Method
fviz_nbclust(df_scaled, kmeans, method="silhouette")

# Cluster Plot
fviz_cluster(kmeans_result, data=df_scaled)

# ---------------- INTERPRETATION: CLUSTER ANALYSIS ----------------
# Dendrogram:
# Large vertical jumps suggest natural cluster divisions.
#
# Elbow Method:
# Elbow point = optimal number of clusters.
#
# Silhouette:
# Near 1 = strong clustering
# Near 0 = overlap
# Negative = poor assignment
#
# K-Means:
# Well-separated clusters = strong segmentation
# Overlap = weak grouping
#
# Overall:
# Cluster analysis groups similar observations for segmentation or pattern discovery.


